  ADD         | r/m32, imm8    | 83 /0 ib
  ADD         | r/m32, imm32   | 81 /0 id
  ADD         | r/m32, r32     | 01 /r
  SUB         | r/m32, imm8    | 83 /5 ib
  SUB         | r/m32, imm32   | 81 /5 id
  SUB         | r/m32, r32     | 29 /r
  DIV         | r/m32          | F7 /6
